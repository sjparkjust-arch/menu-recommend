# config/settings.py 가 읽는 환경변수 템플릿.
# 이 파일을 복사해 .env 를 만들고 값을 채운다. (.env 는 커밋 금지)
#   cp .env.example .env

# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (MariaDB, Server2)
DB_NAME=menudb
DB_USER=menuuser
DB_PASSWORD=change-me
DB_HOST=192.168.32.73
DB_PORT=3306

# Redis (세션/캐시, Server2)
REDIS_URL=redis://192.168.32.73:6379/0

# HTTPS 사용 시: DEBUG=False + https 에서 폼 POST CSRF 통과용 (scheme 포함, 콤마 구분)
# 예) https://192.168.32.74  — 안 쓰면 비워둔다
CSRF_TRUSTED_ORIGINS=
